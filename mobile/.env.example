# Android Emulator, backend default launch profile
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5011

# Public native Auth0 configuration. Replace placeholders before a native build.
# Never add a Client Secret or tokens here or in any EXPO_PUBLIC variable.
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.eu.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=YOUR_NATIVE_CLIENT_ID
EXPO_PUBLIC_AUTH0_AUDIENCE=urn:your-api-identifier
