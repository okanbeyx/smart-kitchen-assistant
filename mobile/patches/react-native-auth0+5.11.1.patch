+// Issue #32: retain Keychain deletion errors before Auth0.swift reduces them to Bool.
+// This is the CredentialsManager's existing storage, not an additional token vault.
+private final class A0IdempotentCredentialsStorage: CredentialsStorage {
+    private let keychain: SimpleKeychain
+    private let deletionLock = NSRecursiveLock()
+    private var deletionFailed = false
+
+    init(keychain: SimpleKeychain) {
+        self.keychain = keychain
+    }
+
+    func getEntry(forKey key: String) -> Data? {
+        return keychain.getEntry(forKey: key)
+    }
+
+    func setEntry(_ data: Data, forKey key: String) -> Bool {
+        return keychain.setEntry(data, forKey: key)
+    }
+
+    func deleteEntry(forKey key: String) -> Bool {
+        deletionLock.lock()
+        defer { deletionLock.unlock() }
+        do {
+            try keychain.deleteItem(forKey: key)
+            return true
+        } catch let error as SimpleKeychainError where error.status == SimpleKeychainError.itemNotFound.status {
+            return true
+        } catch {
+            deletionFailed = true
+            return false
+        }
+    }
+
+    func clear(_ operation: () -> Bool) -> Bool {
+        deletionLock.lock()
+        deletionFailed = false
+        defer {
+            deletionFailed = false
+            deletionLock.unlock()
+        }
+        // Auth0.swift clear() also deletes session metadata but ignores its results.
+        // Keep every genuine deletion failure visible, even if the main key was absent.
+        let removed = operation()
+        return removed && !deletionFailed
+    }
+}
